# Kostenloses Mini-Backend (Supabase) für kollaboratives Erfahrungswissen
# Kopiere diese Datei zu `.env` für die lokale Entwicklung oder hinterlege die Werte
# als GitHub Repository Secrets für das automatische GitHub-Pages-Deployment.

VITE_SUPABASE_URL=https://dein-projekt-id.supabase.co
VITE_SUPABASE_ANON_KEY=dein-public-anon-key
